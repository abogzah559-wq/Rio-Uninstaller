<Window x:Class="RioUninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RioUninstaller"
        Title="Rio Uninstaller" Width="1180" Height="740" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        Icon="pack://application:,,,/Assets/app.ico"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" NumberSubstitution.Substitution="European" NumberSubstitution.CultureSource="Text">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= header ================= -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Image FlowDirection="LeftToRight" Source="pack://application:,,,/Assets/logo256.png" Width="30" Height="30" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight"><Run Text="Rio" FontWeight="Bold"/><Run Text=" Uninstaller" Foreground="{StaticResource Muted}"/></TextBlock>
            </StackPanel>

            <Border Grid.Column="1" Width="460" Height="36" CornerRadius="10" Background="{StaticResource Panel2}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SearchHint" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Dim}" FontSize="13.5"
                               IsHitTestVisible="False" Text="{Binding [Search], Source={x:Static local:Loc.I}}"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SearchBox}" TextChanged="SearchBox_TextChanged"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="LangButton" Style="{StaticResource FlatButton}" Click="Lang_Click" Padding="10,6" Margin="0,0,4,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="LangLabel" Text="EN" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Click="Settings_Click" Padding="10,8" Margin="0,0,10,0" VerticalAlignment="Center"
                        ToolTip="{Binding [Settings], Source={x:Static local:Loc.I}}">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource Muted}"/>
                </Button>
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Min_Click" VerticalAlignment="Top"/>
                <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Max_Click" VerticalAlignment="Top"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" VerticalAlignment="Top"/>
            </StackPanel>
        </Grid>

        <!-- ================= body ================= -->
        <Grid Grid.Row="1" Margin="14,4,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- program list -->
            <Border Background="{StaticResource Panel}" CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="16,12,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [Programs], Source={x:Static local:Loc.I}}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CountText" Grid.Column="1" Margin="10,0,0,0" Foreground="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Background="{StaticResource Panel2}" CornerRadius="8" Padding="3" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SortName" Style="{StaticResource Segment}" GroupName="sort" IsChecked="True" Checked="Sort_Checked"
                                             Content="{Binding [SortName], Source={x:Static local:Loc.I}}"/>
                                <RadioButton x:Name="SortSize" Style="{StaticResource Segment}" GroupName="sort" Checked="Sort_Checked"
                                             Content="{Binding [SortSize], Source={x:Static local:Loc.I}}"/>
                                <RadioButton x:Name="SortDate" Style="{StaticResource Segment}" GroupName="sort" Checked="Sort_Checked"
                                             Content="{Binding [SortDate], Source={x:Static local:Loc.I}}"/>
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="3" Style="{StaticResource FlatButton}" Padding="9,7" Click="Refresh_Click"
                                ToolTip="{Binding [Refresh], Source={x:Static local:Loc.I}}">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Muted}"/>
                        </Button>
                    </Grid>

                    <ListBox x:Name="AppList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="6,0,4,8"
                             ItemContainerStyle="{StaticResource AppItem}" SelectionChanged="AppList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" MouseDoubleClick="AppList_MouseDoubleClick" KeyDown="AppList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="32" Height="32">
                                        <Border CornerRadius="8" Background="{StaticResource Panel2}">
                                            <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                                        </Border>
                                        <Border CornerRadius="8" Background="{StaticResource Panel}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Image FlowDirection="LeftToRight" Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PublisherText}" FontSize="11.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="6,2" Margin="0,0,10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BackgroundDisabled}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="&#xE769;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{StaticResource Accent}"/>
                                        </Border>
                                        <StackPanel MinWidth="70">
                                            <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{StaticResource Text}" HorizontalAlignment="Right" FlowDirection="LeftToRight"/>
                                            <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" FlowDirection="LeftToRight" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Dim}"
                               Visibility="Collapsed" Text="{Binding [NoResults], Source={x:Static local:Loc.I}}"/>
                </Grid>
            </Border>

            <!-- details -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <!-- placeholder -->
                    <StackPanel x:Name="Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                        <Image FlowDirection="LeftToRight" Source="pack://application:,,,/Assets/logo256.png" Width="120" Height="120" Opacity="0.9" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{Binding [SelectHint], Source={x:Static local:Loc.I}}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                        <TextBlock Text="{Binding [SelectHint2], Source={x:Static local:Loc.I}}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer x:Name="Details" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22,22,22,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource Panel2}">
                                    <Grid>
                                        <TextBlock x:Name="DetInitial" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                                        <Image FlowDirection="LeftToRight" x:Name="DetIcon" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetName" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DetPublisher" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="{StaticResource Panel2}" CornerRadius="12" Padding="14,10" Margin="0,18,0,0">
                                <Grid x:Name="InfoGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding [Version], Source={x:Static local:Loc.I}}" Foreground="{StaticResource Muted}" Margin="0,4,16,4" FontSize="12.5"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetVersion" Margin="0,4" FontSize="12.5" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="1" Text="{Binding [Size], Source={x:Static local:Loc.I}}" Foreground="{StaticResource Muted}" Margin="0,4,16,4" FontSize="12.5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetSize" Margin="0,4" FontSize="12.5" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="2" Text="{Binding [Installed], Source={x:Static local:Loc.I}}" Foreground="{StaticResource Muted}" Margin="0,4,16,4" FontSize="12.5"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetDate" Margin="0,4" FontSize="12.5" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="3" Text="{Binding [Location], Source={x:Static local:Loc.I}}" Foreground="{StaticResource Muted}" Margin="0,4,16,4" FontSize="12.5"/>
                                    <Button Grid.Row="3" Grid.Column="1" x:Name="DetLocation" Style="{StaticResource FlatButton}" Padding="4,2" HorizontalAlignment="Right"
                                            Click="OpenFolder_Click" ToolTip="{Binding [OpenFolder], Source={x:Static local:Loc.I}}">
                                        <TextBlock x:Name="DetLocationText" FontSize="12" Foreground="{StaticResource Blue}" TextTrimming="CharacterEllipsis" MaxWidth="250" FlowDirection="LeftToRight"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <WrapPanel x:Name="Chips" Margin="0,14,0,0"/>

                            <!-- actions -->
                            <Button x:Name="NormalBtn" Style="{StaticResource ActionCard}" Click="Normal_Click" Margin="0,8,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BlueSoft}" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{StaticResource Blue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding [NormalTitle], Source={x:Static local:Loc.I}}" FontWeight="SemiBold" FontSize="14.5"/>
                                            <Border Background="{StaticResource BlueSoft}" CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding [Recommended], Source={x:Static local:Loc.I}}" FontSize="10.5" Foreground="{StaticResource Blue}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding [NormalDesc], Source={x:Static local:Loc.I}}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button x:Name="FullBtn" Style="{StaticResource ActionCard}" Click="Full_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding [FullTitle], Source={x:Static local:Loc.I}}" FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource Accent}"/>
                                        <TextBlock Text="{Binding [FullDesc], Source={x:Static local:Loc.I}}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button x:Name="BgBtn" Style="{StaticResource ActionCard}" Click="Bg_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AmberSoft}" VerticalAlignment="Top">
                                        <TextBlock x:Name="BgGlyph" Text="&#xE769;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{StaticResource Amber}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock x:Name="BgTitle" FontWeight="SemiBold" FontSize="14.5"/>
                                        <TextBlock x:Name="BgDesc" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= task / confirm dialog ================= -->
        <Grid x:Name="Overlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#B8000000">
            <Border Width="500" Background="{StaticResource Panel}" CornerRadius="16" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Padding="26,24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="DlgIconBg" Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentSoft}">
                            <Grid>
                                <Image FlowDirection="LeftToRight" x:Name="DlgAppIcon" Width="28" Height="28"/>
                                <TextBlock x:Name="DlgGlyph" FontFamily="{StaticResource Icons}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="DlgTitle" Grid.Column="1" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                    </Grid>
                    <TextBlock x:Name="DlgText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,16,0,0" FontSize="13.5" LineHeight="21"/>

                    <ItemsControl x:Name="StepsList" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <Grid Width="20">
                                        <TextBlock x:Name="g" Text="&#xEA3A;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="t" Text="{Binding Title}" Margin="10,0,0,0" Foreground="{StaticResource Dim}" FontSize="13"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                        <Setter TargetName="g" Property="Text" Value="&#xE895;"/>
                                        <Setter TargetName="g" Property="Foreground" Value="{StaticResource Text}"/>
                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource Text}"/>
                                        <Setter TargetName="t" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Done">
                                        <Setter TargetName="g" Property="Text" Value="&#xE73E;"/>
                                        <Setter TargetName="g" Property="Foreground" Value="{StaticResource Green}"/>
                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource Muted}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Skipped">
                                        <Setter TargetName="g" Property="Text" Value="&#xE738;"/>
                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource Dim}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                        <Setter TargetName="g" Property="Text" Value="&#xE711;"/>
                                        <Setter TargetName="g" Property="Foreground" Value="{StaticResource Accent}"/>
                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource Accent}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <Border Background="{StaticResource Panel2}" CornerRadius="10" Padding="14,10">
                            <TextBlock x:Name="ResultStats" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                        </Border>
                        <TextBlock x:Name="ResultNote" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Amber}" Margin="0,10,0,0" Visibility="Collapsed"/>
                        <Button x:Name="DetailsToggle" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Padding="6,4" Margin="-6,8,0,0" Click="DetailsToggle_Click">
                            <TextBlock x:Name="DetailsToggleText" Foreground="{StaticResource Blue}" FontSize="12.5"/>
                        </Button>
                        <Border x:Name="DetailsBox" Visibility="Collapsed" Background="{StaticResource Bg}" CornerRadius="10" Margin="0,6,0,0">
                            <ListBox x:Name="DetailsList" MaxHeight="200" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}"
                                     FontFamily="Consolas" FontSize="11" FlowDirection="LeftToRight" Padding="6"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="DlgButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="DlgCancel" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="DlgCancel_Click"/>
                        <Button x:Name="DlgOk" Style="{StaticResource DangerButton}" Click="DlgOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= settings ================= -->
        <Grid x:Name="SettingsOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#B8000000" MouseDown="SettingsOverlay_MouseDown">
            <Border Width="460" Background="{StaticResource Panel}" CornerRadius="16" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Padding="26,22" VerticalAlignment="Center" HorizontalAlignment="Center" MouseDown="SettingsCard_MouseDown">
                <StackPanel>
                    <TextBlock Text="{Binding [Settings], Source={x:Static local:Loc.I}}" FontSize="17" FontWeight="Bold" Margin="0,0,0,20"/>
                    <CheckBox x:Name="SetSilent" Style="{StaticResource Toggle}" Click="Setting_Changed">
                        <TextBlock Text="{Binding [SetSilent], Source={x:Static local:Loc.I}}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="SetRestore" Style="{StaticResource Toggle}" Click="Setting_Changed">
                        <TextBlock Text="{Binding [SetRestore], Source={x:Static local:Loc.I}}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="SetSystem" Style="{StaticResource Toggle}" Click="Setting_Changed">
                        <TextBlock Text="{Binding [Hidden], Source={x:Static local:Loc.I}}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [SetLanguage], Source={x:Static local:Loc.I}}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="{StaticResource Panel2}" CornerRadius="8" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LangAr" Style="{StaticResource Segment}" GroupName="lang" Content="العربية" Click="LangRadio_Click"/>
                                <RadioButton x:Name="LangEn" Style="{StaticResource Segment}" GroupName="lang" Content="English" Click="LangRadio_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,24,0,0" Click="SettingsClose_Click"
                            Content="{Binding [Done], Source={x:Static local:Loc.I}}"/>
                    <TextBlock Text="Rio Uninstaller v1.1" Foreground="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Center" Margin="0,14,0,0" FlowDirection="LeftToRight"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
